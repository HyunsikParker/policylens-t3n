# Paths only. Never paste bearer credentials into this file or shell argv.
T3N_DEVELOPER_KEY_FILE=/absolute/path/to/mode-0600/developer-key
T3N_AGENT_API_KEY_FILE=/absolute/path/to/mode-0600/agent-api-key
T3N_PROVISION_RECEIPT_FILE=/absolute/path/to/mode-0600/provision-receipt.json
T3N_CONTRACT_RECEIPT_FILE=/absolute/path/to/mode-0600/contract-receipt.json
T3N_GRANT_RECEIPT_FILE=/absolute/path/to/mode-0600/grant-receipt.json
T3N_EXPECTED_DID_FILE=/absolute/path/to/mode-0600/developer-did
T3N_SESSION_HEALTH_RECEIPT_FILE=/absolute/path/to/mode-0600/session-health-receipt.json
T3N_SESSION_ACCEPTANCE_RECEIPT_FILE=/absolute/path/to/mode-0600/session-acceptance-receipt.json

T3N_NODE_URL=https://sandbox-node-url-from-current-t3n-docs
T3N_CONTRACT_ID=z:40-hex-tenant-id:policy-lens
T3N_CONTRACT_VERSION=0.1.0
T3N_SUBJECT_DID=did:t3n:40-hex-tenant-id
POLICYLENS_WASM_FILE=/absolute/path/to/policylens_contract.wasm
POLICYLENS_POLICY_FILE=/absolute/path/to/fixtures/policy.json
POLICYLENS_FIXTURE_DIR=/absolute/path/to/fixtures

    "grant": "tsx scripts/grant-agent.ts",
    "diagnose:grant": "tsx scripts/diagnose-grant.ts",
    "probe:invoke": "tsx scripts/probe-invoke-route.ts",
    "probe:session": "tsx scripts/session-health.ts",
    "acceptance:live": "tsx scripts/live-acceptance.ts",
    "acceptance:session": "tsx scripts/session-acceptance.ts",
    "recover:receipt": "tsx scripts/recover-acceptance-receipt.ts"
  },
  "dependencies": {
    "@terminal3/t3n-sdk": "5.2.0"
